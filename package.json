{
  "name": "miau",
  "version": "1.0.0",
  "private": true,
  "description": "MIAU — Urban Art Map (monorepo root)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "concurrently \"npm test --prefix backend\" \"npm test --prefix frontend\"",
    "test:scripts": "vitest run --config scripts/vitest.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "fast-check": "^3.15.0",
    "sharp": "^0.33.0",
    "vitest": "^3.2.3"
  }
}
