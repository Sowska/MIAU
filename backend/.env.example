PORT=5000
MONGODB_URI=mongodb://localhost:27017/urban-art-map
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173/

# Image storage provider: "local" (default) or "s3"
STORAGE_PROVIDER=local

# AWS S3 configuration (only needed when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
